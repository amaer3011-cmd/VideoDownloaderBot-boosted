# Required Telegram token
BOT_TOKEN=

# Operational settings
LOGS_CHAT_ID=
OUTPUT_FOLDER=/app/data/downloads
LOGS_DIR=/app/logs
MAX_FILESIZE=52428800
WORKERS=2
MAX_QUEUE=200
UPLOAD_WORKERS=2
JOB_TIMEOUT_SECONDS=900
PENDING_TTL_SECONDS=600
YTDLP_CONCURRENT_FRAGMENTS=8
YTDLP_HTTP_CHUNK_SIZE=10485760
PLAYLIST_MAX=10
COOKIES_FILE=
# Alternative for Railway: the cookies file as one base64 line (see README)
# COOKIES_B64=
LOG_LEVEL=INFO

# yt-dlp site compatibility
YTDLP_JS_RUNTIMES=node
YTDLP_REMOTE_COMPONENTS=
YTDLP_YOUTUBE_PLAYER_CLIENTS=default,tv,web_safari,mweb
YTDLP_INSTAGRAM_IMPERSONATE=chrome
YTDLP_INSTAGRAM_RETRIES=8
YTDLP_INSTAGRAM_FRAGMENT_RETRIES=8
YTDLP_INSTAGRAM_SOCKET_TIMEOUT=30
YTDLP_GENERIC_IMPERSONATE=chrome
METADATA_WORKERS=2
METADATA_TIMEOUT_SECONDS=60

# Optional boosters (docker compose --profile boost up -d), see docker-compose.yml
# YTDLP_POT_BASE_URL=http://bgutil-pot:4416
# TELEGRAM_API_URL=http://telegram-bot-api:8081
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
